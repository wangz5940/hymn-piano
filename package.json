{
  "name": "shiqin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate:hymns": "node scripts/generate-hymn-catalog.mjs",
    "generate:scores": "tsx scripts/generate-score-assets.ts",
    "ocr:hymns": "swift scripts/ocr-hymn-images.swift resource/歌谱 data/hymn-ocr.jsonl",
    "check:fonts": "tsx scripts/check-simpmusic-fonts.ts",
    "predev": "npm run generate:scores",
    "dev": "vite",
    "dev:start": "node scripts/dev-server.mjs start",
    "dev:stop": "node scripts/dev-server.mjs stop",
    "dev:restart": "node scripts/dev-server.mjs restart",
    "dev:status": "node scripts/dev-server.mjs status",
    "start": "npm run dev:start",
    "stop": "npm run dev:stop",
    "restart": "npm run dev:restart",
    "prebuild": "npm run check:fonts && npm run generate:scores",
    "build": "tsc -b && vite build",
    "postbuild": "find dist -name .DS_Store -delete",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview",
    "check": "tsc -b --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.6",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
